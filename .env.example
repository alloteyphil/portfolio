GITHUB_TOKEN=
GITHUB_USERNAME=
SCREENSHOTONE_API_KEY=
# Cloudinary Dashboard → Settings → Product environment credentials → Cloud name (not the "portfolio/" folder in image paths)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REFRESH_SCREENSHOTS_SECRET=
VERCEL_DEPLOY_HOOK_URL=
NEXT_PUBLIC_SITE_URL=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: live visitor numbers for dilli-dilli.com on the homepage, from Vercel Web Analytics (refreshed daily).
# VERCEL_ANALYTICS_TOKEN: a Vercel access token (vercel.com/account/tokens).
# DILLI_VERCEL_PROJECT_ID: the dilli-dilli project's ID (Project Settings → General), e.g. prj_...
# DILLI_VERCEL_TEAM_ID: only if that project belongs to a team, e.g. team_...
# Without these the homepage shows the April 2026 figure.
VERCEL_ANALYTICS_TOKEN=
DILLI_VERCEL_PROJECT_ID=
DILLI_VERCEL_TEAM_ID=
# Optional: repo holding data/portfolio-config.json (manual projects + order). Defaults to ${GITHUB_USERNAME}/portfolio.
PORTFOLIO_CONFIG_REPO=
PORTFOLIO_CONFIG_REPO_NAME=
